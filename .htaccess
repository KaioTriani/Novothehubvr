# The Hub VR · Apache / LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Arquivos do repositório que não devem ser servidos (deploy via Git)
RedirectMatch 404 /\.git
RedirectMatch 404 /\.gitignore$
RedirectMatch 404 /README\.md$
RedirectMatch 404 /HOSTINGER\.md$

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Domínio oficial sem www vai para https://www (o endereço temporário da Hostinger não é afetado)
  RewriteCond %{HTTP_HOST} ^thehubvr\.com\.br$ [NC]
  RewriteRule ^ https://www.thehubvr.com.br%{REQUEST_URI} [L,R=301]
  # Qualquer endereço acessado por http passa para https, mantendo o mesmo domínio
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Páginas do site antigo apontam para as seções novas
  RewriteRule ^agendar-experiencia/?$ /#contato [NE,L,R=301]
  RewriteRule ^entre-em-contato/?$ /#contato [NE,L,R=301]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|webp|jpg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
